<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/text_bmi_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bmi_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/input_weight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/bmi_weight_hint"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/input_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/bmi_height_hint"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/button_calculate_bmi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/button_calculate_bmi" />

    <TextView
        android:id="@+id/text_bmi_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="16sp" />
</LinearLayout>
